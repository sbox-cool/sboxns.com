{
  "name": "sboxns-docs-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Generates the sboxns.com /docs/ pages from the server and library repositories.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node versions.mjs",
    "check:links": "node check-links.mjs",
    "track:revisions": "node track-revisions.mjs",
    "reconcile:releases": "node reconcile-releases.mjs",
    "test": "node --test *.test.mjs"
  },
  "dependencies": {
    "marked": "18.1.1"
  }
}

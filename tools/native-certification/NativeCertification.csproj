<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>disable</Nullable>
    <DefineConstants>SANDBOX</DefineConstants>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SboxManaged>$(SboxGame)/bin/managed</SboxManaged>
    <NoWarn>1701;1702;1591;MSB3246;MSB3245;CS0612;CS0618</NoWarn>
  </PropertyGroup>
  <Target Name="RequireInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SboxManaged)/Sandbox.Engine.dll')" Text="Set SboxGame to an installed engine game directory." />
    <Error Condition="!Exists('$(NsLibrary)/publication.json')" Text="Use download-library.mjs to supply a verified published source directory." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
    <Using Include="Sandbox.Internal.GlobalGameNamespace" Static="true" />
    <Using Include="Microsoft.AspNetCore.Components" />
    <Using Include="Microsoft.AspNetCore.Components.Rendering" />
    <Compile Include="$(NsLibrary)/Code/**/*.cs" LinkBase="PublishedLibrary" />
    <Compile Include="*.cs" />
    <Analyzer Include="$(SboxManaged)/Sandbox.Generator.dll" />
    <Reference Include="$(SboxManaged)/*.dll" Exclude="$(SboxManaged)/Sandbox.Generator.dll;$(SboxManaged)/Sandbox.CodeUpgrader.dll" Private="true" />
  </ItemGroup>
</Project>
